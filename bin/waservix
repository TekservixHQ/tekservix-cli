#!/usr/bin/env bash
# waservix - command-line client for the WAservix WhatsApp API Gateway (https://tekservix.com/waservix/)
# Needs a Tekservix account with WAservix and your number's API key in WASERVIX_KEY.
set -euo pipefail

VERSION="1.0.0"
BASE_URL="${WASERVIX_BASE_URL:-https://tekservix.com/waservix/api}"
BASE_URL="${BASE_URL%/}"

usage() {
  cat <<'EOF'
waservix - send WhatsApp messages from your own number (WAservix)

Usage:
  waservix send --to NUMBER_OR_GROUP --text TEXT
  waservix send --to NUMBER --image URL [--caption TEXT]
  waservix send --to NUMBER --document URL [--filename NAME] [--caption TEXT]
  waservix status MESSAGE_ID         queued, sent, delivered, read, played or failed
  waservix check PHONE               is this number on WhatsApp?
  waservix connection                connection status of your number
  waservix groups | contacts
  waservix api METHOD PATH [JSON]    call any endpoint, e.g. waservix api GET /user
  waservix --version | --help

Environment:
  WASERVIX_KEY       API key of your number (WAservix dashboard -> Devices), required
  WASERVIX_BASE_URL  override the API base URL (testing only)

Output is the JSON "data" of the answer (pretty-printed when jq is installed).
Exit code 1 on API errors (message on stderr; 503 = number reconnecting), 2 on usage errors.
Docs: https://tekservix.com/waservix/docs/
EOF
}

die() { echo "waservix: $*" >&2; exit 2; }

json_str() {
  local s=$1 out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case "$c" in
      '"') out+='\"' ;;
      '\') out+='\\' ;;
      $'\n') out+='\n' ;;
      $'\r') out+='\r' ;;
      $'\t') out+='\t' ;;
      *) out+="$c" ;;
    esac
  done
  printf '"%s"' "$out"
}

urlenc() {
  local LC_ALL=C s=$1 out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) out+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  printf '%s' "$out"
}

call() {
  local method=$1 path=$2 body=${3:-}
  [ -n "${WASERVIX_KEY:-}" ] || { echo "waservix: set WASERVIX_KEY to your number's API key (Devices in the dashboard)" >&2; exit 2; }
  local args=(-sS -X "$method" -H "Authorization: Bearer $WASERVIX_KEY" -H "Accept: application/json"
    -H "User-Agent: waservix-cli/$VERSION" --max-time 30 -w $'\n%{http_code}')
  [ -n "$body" ] && args+=(-H "Content-Type: application/json" --data "$body")
  local res status text
  res=$(curl "${args[@]}" "$BASE_URL$path") || { echo "waservix: request failed" >&2; exit 1; }
  status=${res##*$'\n'}
  text=${res%$'\n'*}
  if [ "$status" -ge 400 ] || printf '%s' "$text" | grep -Eq '"success"[[:space:]]*:[[:space:]]*false'; then
    local msg
    msg=$(printf '%s' "$text" | sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
    echo "waservix: ${msg:-HTTP $status} (HTTP $status)" >&2
    exit 1
  fi
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$text" | jq 'if type == "object" and has("data") then .data else . end'
  else
    printf '%s\n' "$text"
  fi
}

[ $# -gt 0 ] || { usage; exit 2; }
cmd=$1; shift

case "$cmd" in
  -h|--help|help) usage ;;
  -v|--version|version) echo "waservix $VERSION" ;;
  send)
    to="" text="" image="" document="" filename="" caption=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --to) to=${2:-}; shift 2 ;;
        --text|-t) text=${2:-}; shift 2 ;;
        --image) image=${2:-}; shift 2 ;;
        --document) document=${2:-}; shift 2 ;;
        --filename) filename=${2:-}; shift 2 ;;
        --caption) caption=${2:-}; shift 2 ;;
        *) die "unknown option $1 (see waservix --help)" ;;
      esac
    done
    [ -n "$to" ] || die "send needs --to"
    body="{\"to\":$(json_str "$to")"
    if [ -n "$image" ]; then
      body+=",\"imageUrl\":$(json_str "$image")"
      [ -n "$caption" ] && body+=",\"text\":$(json_str "$caption")"
    elif [ -n "$document" ]; then
      body+=",\"documentUrl\":$(json_str "$document")"
      [ -n "$filename" ] && body+=",\"fileName\":$(json_str "$filename")"
      [ -n "$caption" ] && body+=",\"text\":$(json_str "$caption")"
    elif [ -n "$text" ]; then
      body+=",\"text\":$(json_str "$text")"
    else
      die "send needs --text, --image or --document"
    fi
    body+="}"
    call POST /send-message "$body"
    ;;
  status) [ $# -eq 1 ] || die "usage: waservix status MESSAGE_ID"; call GET "/messages/$(urlenc "$1")/info" ;;
  check) [ $# -eq 1 ] || die "usage: waservix check PHONE"; call GET "/on-whatsapp/$(urlenc "$1")" ;;
  connection) call GET /status ;;
  groups) call GET /groups ;;
  contacts) call GET /contacts ;;
  api)
    [ $# -ge 2 ] || die "usage: waservix api METHOD PATH [JSON]"
    call "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')" "$2" "${3:-}"
    ;;
  *) die "unknown command $cmd (see waservix --help)" ;;
esac
