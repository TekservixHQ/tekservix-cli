#!/usr/bin/env bash
# smsgora - command-line client for the SMS Gora SMS Gateway API (https://tekservix.com/smsgora/)
# Needs a Tekservix account with SMS Gora and an API key in SMSGORA_KEY.
set -euo pipefail

VERSION="1.0.0"
BASE_URL="${SMSGORA_BASE_URL:-https://tekservix.com/smsgora/api/v1}"
BASE_URL="${BASE_URL%/}"

usage() {
  cat <<'EOF'
smsgora - send and receive SMS through your own Android phones (SMS Gora)

Usage:
  smsgora send --to NUMBER[,NUMBER...] --message TEXT [--device ID] [--sim 0|1] [--schedule ISO8601]
  smsgora status MESSAGE_ID          delivery status of a message
  smsgora cancel MESSAGE_ID          cancel a queued or scheduled message
  smsgora inbox [--limit N] [--since DATE] [--device ID]
  smsgora messages [--status S] [--limit N]
  smsgora devices                    your linked phones
  smsgora account                    plan and usage
  smsgora api METHOD PATH [JSON]     call any endpoint, e.g. smsgora api GET /webhooks
  smsgora --version | --help

Environment:
  SMSGORA_KEY       your API key (SMS Gora -> API keys), required
  SMSGORA_BASE_URL  override the API base URL (testing only)

Output is the JSON "data" of the answer (pretty-printed when jq is installed).
Exit code 1 on API errors (message on stderr), 2 on usage errors.
Docs: https://tekservix.com/smsgora/docs/
EOF
}

die() { echo "smsgora: $*" >&2; exit 2; }

json_str() {
  local s=$1 out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case "$c" in
      '"') out+='\"' ;;
      '\') out+='\\' ;;
      $'\n') out+='\n' ;;
      $'\r') out+='\r' ;;
      $'\t') out+='\t' ;;
      *) out+="$c" ;;
    esac
  done
  printf '"%s"' "$out"
}

json_list() {
  local IFS=, item out="" first=1
  for item in $1; do
    item="${item#"${item%%[![:space:]]*}"}"; item="${item%"${item##*[![:space:]]}"}"
    [ -z "$item" ] && continue
    [ $first -eq 1 ] || out+=","
    out+=$(json_str "$item"); first=0
  done
  printf '[%s]' "$out"
}

urlenc() {
  local LC_ALL=C s=$1 out="" c i
  for ((i = 0; i < ${#s}; i++)); do
    c=${s:i:1}
    case "$c" in
      [a-zA-Z0-9.~_-]) out+="$c" ;;
      *) out+=$(printf '%%%02X' "'$c") ;;
    esac
  done
  printf '%s' "$out"
}

call() {
  local method=$1 path=$2 body=${3:-}
  [ -n "${SMSGORA_KEY:-}" ] || { echo "smsgora: set SMSGORA_KEY to your API key (SMS Gora -> API keys)" >&2; exit 2; }
  local args=(-sS -X "$method" -H "x-api-key: $SMSGORA_KEY" -H "Accept: application/json"
    -H "User-Agent: smsgora-cli/$VERSION" --max-time 30 -w $'\n%{http_code}')
  [ -n "$body" ] && args+=(-H "Content-Type: application/json" --data "$body")
  local res status text
  res=$(curl "${args[@]}" "$BASE_URL$path") || { echo "smsgora: request failed" >&2; exit 1; }
  status=${res##*$'\n'}
  text=${res%$'\n'*}
  if [ "$status" -ge 400 ] || printf '%s' "$text" | grep -Eq '"success"[[:space:]]*:[[:space:]]*false'; then
    local msg
    msg=$(printf '%s' "$text" | sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | head -n1)
    echo "smsgora: ${msg:-HTTP $status} (HTTP $status)" >&2
    exit 1
  fi
  if command -v jq >/dev/null 2>&1; then
    printf '%s' "$text" | jq 'if type == "object" and has("data") then .data else . end'
  else
    printf '%s\n' "$text"
  fi
}

[ $# -gt 0 ] || { usage; exit 2; }
cmd=$1; shift

case "$cmd" in
  -h|--help|help) usage ;;
  -v|--version|version) echo "smsgora $VERSION" ;;
  send)
    to="" message="" device="" sim="" schedule=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --to) to=${2:-}; shift 2 ;;
        --message|-m) message=${2:-}; shift 2 ;;
        --device) device=${2:-}; shift 2 ;;
        --sim) sim=${2:-}; shift 2 ;;
        --schedule) schedule=${2:-}; shift 2 ;;
        *) die "unknown option $1 (see smsgora --help)" ;;
      esac
    done
    [ -n "$to" ] || die "send needs --to"
    [ -n "$message" ] || die "send needs --message"
    body="{\"recipients\":$(json_list "$to"),\"message\":$(json_str "$message")"
    if [ -n "$sim" ]; then
      case "$sim" in 0|1) body+=",\"sim_slot\":$sim" ;; *) die "--sim must be 0 or 1" ;; esac
    fi
    [ -n "$schedule" ] && body+=",\"schedule_at\":$(json_str "$schedule")"
    body+="}"
    if [ -n "$device" ]; then call POST "/devices/$(urlenc "$device")/send-sms" "$body"; else call POST /send-sms "$body"; fi
    ;;
  status) [ $# -eq 1 ] || die "usage: smsgora status MESSAGE_ID"; call GET "/messages/$(urlenc "$1")" ;;
  cancel) [ $# -eq 1 ] || die "usage: smsgora cancel MESSAGE_ID"; call POST "/messages/$(urlenc "$1")/cancel" ;;
  inbox|messages)
    q="" device=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --limit|--since|--status|--phone|--page)
          q+="${q:+&}${1#--}=$(urlenc "${2:-}")"; shift 2 ;;
        --device) device=${2:-}; shift 2 ;;
        *) die "unknown option $1" ;;
      esac
    done
    if [ "$cmd" = inbox ]; then
      path=/received-sms; [ -n "$device" ] && path="/devices/$(urlenc "$device")/get-received-sms"
    else
      path=/messages; [ -n "$device" ] && q+="${q:+&}device_id=$(urlenc "$device")"
    fi
    call GET "$path${q:+?$q}"
    ;;
  devices) call GET /devices ;;
  account) call GET /account ;;
  api)
    [ $# -ge 2 ] || die "usage: smsgora api METHOD PATH [JSON]"
    call "$(printf '%s' "$1" | tr '[:lower:]' '[:upper:]')" "$2" "${3:-}"
    ;;
  *) die "unknown command $cmd (see smsgora --help)" ;;
esac
